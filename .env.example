# Copie para .env e preencha. Ou rode "npm run configurar", que faz isso sozinho.

# Assina os tokens. Obrigatório, mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Sem os dois, não abre dentro do Discord.
# No portal: https://discord.com/developers/applications, aba OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Opcional. Confere se a pessoa está mesmo na call, e traz nome, imagem e
# tamanho dos servidores no painel. O bot precisa estar no servidor.
# No mesmo portal, aba Bot, botão Reset Token.
DISCORD_BOT_TOKEN=

# Endereço público. Quem abre o túnel preenche sozinho.
PUBLIC_ORIGIN=http://localhost:3001

# Porta local.
PORT=3001

# "production" liga as travas de segurança.
NODE_ENV=development

# Túnel de endereço fixo. Preenchido por "npm run tunel:criar".
TUNEL_CONFIG=

# ID da sua conta, não o Client ID nem o do servidor. Mais de um: separe por vírgula.
# No Discord, não no portal: Configurações, Avançado, Modo desenvolvedor.
# Depois botão direito no seu nome, Copiar ID.
# Só estas contas abrem /admin. Vazio = painel desligado.
DISCORD_ADMIN_ID=

# Opcional. Servidor TURN para a conexão direta entre quem transmite e quem
# assiste. Sem ele o WebRTC ainda funciona na maioria das casas — o STUN
# público basta —, mas quem está atrás de NAT simétrico (CGNAT da operadora,
# rede corporativa) não consegue fechar e cai no relay, que é mais pesado para
# o servidor. TURN encaminha o vídeo de fato, então custa banda.
TURN_URL=
TURN_USER=
TURN_PASS=

# WebTransport/HTTP/3 é opcional. Desligado, o servidor não carrega addon,
# certificado nem abre UDP; WebSocket continua sendo o caminho universal.
WEBTRANSPORT_ENABLED=false

# Listener UDP/QUIC. Em produção, host e porta são obrigatórios. A porta precisa
# receber UDP direto no firewall/balanceador; encaminhar apenas HTTPS/TCP não basta.
WEBTRANSPORT_HOST=127.0.0.1
WEBTRANSPORT_PORT=4443

# URL HTTPS limpa anunciada ao browser, sem query ou fragmento. Em sharding,
# configure cada nó com a própria URL e preserve o prefixo /nK quando houver.
WEBTRANSPORT_PUBLIC_URL=https://media.example.invalid:4443/wt

# webpki: certificado público normal, com host/SAN/cadeia válidos.
# hash: certificado ECDSA P-256 de no máximo 14 dias, fixado por SHA-256.
WEBTRANSPORT_CERT_MODE=webpki
WEBTRANSPORT_CERT_PATH=C:\caminho\ficticio\cert.pem
WEBTRANSPORT_KEY_PATH=C:\caminho\ficticio\key.pem

# Opcionais e sempre em par. No modo hash, o listener publica current+next,
# troca o certificado e depois retira o hash antigo sem janela inconsistente.
WEBTRANSPORT_NEXT_CERT_PATH=
WEBTRANSPORT_NEXT_KEY_PATH=
